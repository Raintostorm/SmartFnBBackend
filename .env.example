NODE_ENV=development
PORT=3100
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

POSTGRES_USER=smartfnb
POSTGRES_PASSWORD=smartfnb_dev_password
POSTGRES_DB=smart_fnb
POSTGRES_PORT=5433
DATABASE_URL=postgresql://smartfnb:smartfnb_dev_password@127.0.0.1:5433/smart_fnb?schema=public

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=smart-fnb-backend
JWT_AUDIENCE=smart-fnb-client

# Optional, one-time ADMIN bootstrap used by `pnpm prisma:seed`.
# Set both values to create the account, then remove the password from your environment.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum RestaurantChainStatus {
  ACTIVE
  INACTIVE
}

enum BranchAreaType {
  DINING
  KITCHEN
  BAR
  CASHIER
  PICKUP
}

enum BranchAreaStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum TableSessionStatus {
  OPEN
  SERVING
  PAID
  CLOSED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum OrderItemStatus {
  PENDING
  QUEUED
  CONFIRMED
  PREPARING
  READY
  SERVED
  OUT_OF_STOCK
  CANCELLED
}

enum ServingTaskStatus {
  WAITING
  CLAIMED
  SERVED
  CANCELLED
}

enum WorkSessionStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  E_WALLET
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum VoucherType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]

  @@map("roles")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(255)
  phone           String?    @unique @db.VarChar(20)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  roleId          String     @map("role_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  role                      Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employee                  Employee?
  owner                     Owner?
  sessions                  AuthSession[]
  ownerChainAssignmentsMade OwnerChainAssignment[] @relation("OwnerChainAssignedBy")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RestaurantChain {
  id                  String                @id @default(uuid()) @db.Uuid
  code                String                @unique @db.VarChar(50)
  name                String                @db.VarChar(150)
  logoUrl             String?               @map("logo_url") @db.VarChar(500)
  email               String?               @db.VarChar(255)
  phone               String?               @db.VarChar(20)
  website             String?               @db.VarChar(500)
  taxCode             String?               @map("tax_code") @db.VarChar(50)
  headquartersAddress String?               @map("headquarters_address") @db.VarChar(500)
  timezone            String                @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  currency            String                @default("VND") @db.VarChar(3)
  status              RestaurantChainStatus @default(ACTIVE)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?             @map("deleted_at") @db.Timestamptz(6)

  branches         Branch[]
  ownerAssignments OwnerChainAssignment[]

  @@index([status])
  @@map("restaurant_chains")
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  chainId      String       @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @map("chain_id") @db.Uuid
  code         String       @unique @db.VarChar(50)
  name         String       @db.VarChar(150)
  phone        String?      @db.VarChar(20)
  email        String?      @db.VarChar(255)
  addressLine1 String       @map("address_line_1") @db.VarChar(255)
  addressLine2 String?      @map("address_line_2") @db.VarChar(255)
  ward         String?      @db.VarChar(100)
  district     String?      @db.VarChar(100)
  city         String       @db.VarChar(100)
  country      String       @default("Vietnam") @db.VarChar(100)
  timezone     String       @default("Asia/Ho_Chi_Minh") @db.VarChar(50)
  status       BranchStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(6)

  chain            RestaurantChain       @relation(fields: [chainId], references: [id], onDelete: Restrict)
  operatingHours   BranchOperatingHour[]
  specialHours     BranchSpecialHour[]
  areas            BranchArea[]
  employees        Employee[]
  tables           RestaurantTable[]
  reservations     Reservation[]
  menuCategories   MenuCategory[]
  orders           Order[]
  vouchers         Voucher[]
  attendances      Attendance[]
  workSessions     WorkSession[]
  tableSessions    TableSession[]
  tableAdjacencies TableAdjacency[]
  branchMenuItems  BranchMenuItem[]
  servingTasks     ServingTask[]

  @@index([chainId, status])
  @@index([status])
  @@index([city])
  @@map("branches")
}

model BranchOperatingHour {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week")
  openTime  String?  @map("open_time") @db.VarChar(5)
  closeTime String?  @map("close_time") @db.VarChar(5)
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@index([branchId])
  @@map("branch_operating_hours")
}

model BranchSpecialHour {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  date      DateTime @db.Date
  openTime  String?  @map("open_time") @db.VarChar(5)
  closeTime String?  @map("close_time") @db.VarChar(5)
  isClosed  Boolean  @default(false) @map("is_closed")
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([branchId, date])
  @@map("branch_special_hours")
}

model BranchArea {
  id        String           @id @default(uuid()) @db.Uuid
  branchId  String           @map("branch_id") @db.Uuid
  code      String           @db.VarChar(50)
  name      String           @db.VarChar(150)
  type      BranchAreaType
  floor     Int              @default(1)
  status    BranchAreaStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, code])
  @@index([branchId, type, status])
  @@map("branch_areas")
}

model Employee {
  id           String         @id @default(uuid()) @db.Uuid
  employeeCode String         @unique @map("employee_code") @db.VarChar(50)
  userId       String         @unique @map("user_id") @db.Uuid
  branchId     String         @map("branch_id") @db.Uuid
  firstName    String         @map("first_name") @db.VarChar(100)
  lastName     String         @map("last_name") @db.VarChar(100)
  dateOfBirth  DateTime?      @map("date_of_birth") @db.Date
  jobTitle     String?        @map("job_title") @db.VarChar(100)
  hireDate     DateTime       @default(now()) @map("hire_date") @db.Date
  status       EmployeeStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)

  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch                 Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  confirmedReservations  Reservation[]    @relation("ReservationConfirmedBy")
  servedOrders           Order[]          @relation("OrderWaiter")
  createdOrders          Order[]          @relation("OrderCreatedByWaiter")
  openedTableSessions    TableSession[]   @relation("TableSessionOpenedBy")
  closedTableSessions    TableSession[]   @relation("TableSessionClosedBy")
  workSessions           WorkSession[]
  updatedBranchMenuItems BranchMenuItem[] @relation("BranchMenuItemUpdatedBy")
  servedOrderItems       OrderItem[]      @relation("OrderItemServedBy")
  cancelledOrderItems    OrderItem[]      @relation("OrderItemCancelledBy")
  unavailableOrderItems  OrderItem[]      @relation("OrderItemUnavailableBy")
  startedOrderItems      OrderItem[]      @relation("OrderItemStartedByKitchen")
  completedOrderItems    OrderItem[]      @relation("OrderItemCompletedByKitchen")
  claimedServingTasks    ServingTask[]    @relation("ServingTaskClaimedBy")
  completedServingTasks  ServingTask[]    @relation("ServingTaskServedBy")
  processedPayments      Payment[]        @relation("PaymentProcessedBy")
  attendances            Attendance[]

  @@index([branchId])
  @@index([status])
  @@map("employees")
}

model Owner {
  id          String    @id @default(uuid()) @db.Uuid
  ownerCode   String    @unique @map("owner_code") @db.VarChar(50)
  userId      String    @unique @map("user_id") @db.Uuid
  firstName   String    @map("first_name") @db.VarChar(100)
  lastName    String    @map("last_name") @db.VarChar(100)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chainAssignments OwnerChainAssignment[]

  @@map("owners")
}

model OwnerChainAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  chainId      String   @map("chain_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  owner      Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chain      RestaurantChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  assignedBy User?           @relation("OwnerChainAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([ownerId, chainId])
  @@index([chainId])
  @@index([assignedById])
  @@map("owner_chain_assignments")
}

model RestaurantTable {
  id        String      @id @default(uuid()) @db.Uuid
  branchId  String      @map("branch_id") @db.Uuid
  code      String      @db.VarChar(50)
  name      String?     @db.VarChar(100)
  area      String?     @db.VarChar(100)
  floor     Int         @default(1)
  capacity  Int
  positionX Decimal?    @map("position_x") @db.Decimal(10, 2)
  positionY Decimal?    @map("position_y") @db.Decimal(10, 2)
  width     Decimal?    @db.Decimal(10, 2)
  height    Decimal?    @db.Decimal(10, 2)
  status    TableStatus @default(AVAILABLE)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz(6)

  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reservations  Reservation[]
  orders        Order[]
  sessionTables TableSessionTable[]
  adjacentFrom  TableAdjacency[]    @relation("TableAdjacencyFrom")
  adjacentTo    TableAdjacency[]    @relation("TableAdjacencyTo")

  @@unique([branchId, code])
  @@index([branchId, status])
  @@map("restaurant_tables")
}

model TableAdjacency {
  id              String   @id @default(uuid()) @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  tableId         String   @map("table_id") @db.Uuid
  adjacentTableId String   @map("adjacent_table_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table         RestaurantTable @relation("TableAdjacencyFrom", fields: [tableId], references: [id], onDelete: Cascade)
  adjacentTable RestaurantTable @relation("TableAdjacencyTo", fields: [adjacentTableId], references: [id], onDelete: Cascade)

  @@unique([tableId, adjacentTableId])
  @@index([branchId])
  @@index([adjacentTableId])
  @@map("table_adjacencies")
}

model TableSession {
  id                 String             @id @default(uuid()) @db.Uuid
  sessionCode        String             @unique @map("session_code") @db.VarChar(50)
  branchId           String             @map("branch_id") @db.Uuid
  reservationId      String?            @unique @map("reservation_id") @db.Uuid
  openedByWaiterId   String             @map("opened_by_waiter_id") @db.Uuid
  closedByWaiterId   String?            @map("closed_by_waiter_id") @db.Uuid
  guestCount         Int                @map("guest_count")
  status             TableSessionStatus @default(OPEN)
  paymentStatus      OrderPaymentStatus @default(UNPAID) @map("payment_status")
  guestName          String?            @map("guest_name") @db.VarChar(150)
  guestPhone         String?            @map("guest_phone") @db.VarChar(20)
  note               String?            @db.VarChar(500)
  openedAt           DateTime           @default(now()) @map("opened_at") @db.Timestamptz(6)
  paidAt             DateTime?          @map("paid_at") @db.Timestamptz(6)
  closedAt           DateTime?          @map("closed_at") @db.Timestamptz(6)
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?            @map("cancellation_reason") @db.VarChar(500)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reservation    Reservation?        @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  openedByWaiter Employee            @relation("TableSessionOpenedBy", fields: [openedByWaiterId], references: [id], onDelete: Restrict)
  closedByWaiter Employee?           @relation("TableSessionClosedBy", fields: [closedByWaiterId], references: [id], onDelete: SetNull)
  tables         TableSessionTable[]
  orders         Order[]
  payments       Payment[]

  @@index([branchId, status])
  @@index([openedByWaiterId, openedAt])
  @@map("table_sessions")
}

model TableSessionTable {
  tableSessionId String    @map("table_session_id") @db.Uuid
  tableId        String    @map("table_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(6)

  tableSession TableSession    @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  table        RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@id([tableSessionId, tableId])
  @@index([tableId, releasedAt])
  @@map("table_session_tables")
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  reservationCode String            @unique @map("reservation_code") @db.VarChar(50)
  branchId        String            @map("branch_id") @db.Uuid
  tableId         String?           @map("table_id") @db.Uuid
  confirmedById   String?           @map("confirmed_by_id") @db.Uuid
  guestName       String            @map("guest_name") @db.VarChar(150)
  guestPhone      String            @map("guest_phone") @db.VarChar(20)
  guestEmail      String?           @map("guest_email") @db.VarChar(255)
  partySize       Int               @map("party_size")
  reservationAt   DateTime          @map("reservation_at") @db.Timestamptz(6)
  durationMinutes Int               @default(120) @map("duration_minutes")
  status          ReservationStatus @default(PENDING)
  note            String?           @db.Text
  confirmedAt     DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table        RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  confirmedBy  Employee?        @relation("ReservationConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  order        Order?
  tableSession TableSession?

  @@index([branchId, reservationAt])
  @@index([tableId, reservationAt])
  @@index([status])
  @@map("reservations")
}

model MenuCategory {
  id           String    @id @default(uuid()) @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  name         String    @db.VarChar(150)
  description  String?   @db.VarChar(500)
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items  MenuItem[]

  @@unique([branchId, name])
  @@index([branchId, isActive, displayOrder])
  @@map("menu_categories")
}

model MenuItem {
  id                 String    @id @default(uuid()) @db.Uuid
  categoryId         String    @map("category_id") @db.Uuid
  sku                String    @unique @db.VarChar(50)
  name               String    @db.VarChar(150)
  description        String?   @db.Text
  price              Decimal   @db.Decimal(14, 2)
  costPrice          Decimal?  @map("cost_price") @db.Decimal(14, 2)
  imageUrl           String?   @map("image_url") @db.VarChar(500)
  preparationMinutes Int?      @map("preparation_minutes")
  isAvailable        Boolean   @default(true) @map("is_available")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  category           MenuCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems         OrderItem[]
  branchAvailability BranchMenuItem[]

  @@index([categoryId, isActive, isAvailable])
  @@index([name])
  @@map("menu_items")
}

model BranchMenuItem {
  branchId          String   @map("branch_id") @db.Uuid
  menuItemId        String   @map("menu_item_id") @db.Uuid
  isEnabled         Boolean  @default(true) @map("is_enabled")
  isAvailable       Boolean  @default(true) @map("is_available")
  remainingPortions Int?     @map("remaining_portions")
  updatedById       String?  @map("updated_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  updatedBy Employee? @relation("BranchMenuItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@id([branchId, menuItemId])
  @@index([branchId, isEnabled, isAvailable])
  @@index([updatedById])
  @@map("branch_menu_items")
}

model Order {
  id                String             @id @default(uuid()) @db.Uuid
  orderCode         String             @unique @map("order_code") @db.VarChar(50)
  branchId          String             @map("branch_id") @db.Uuid
  tableId           String?            @map("table_id") @db.Uuid
  reservationId     String?            @unique @map("reservation_id") @db.Uuid
  waiterId          String?            @map("waiter_id") @db.Uuid
  tableSessionId    String?            @map("table_session_id") @db.Uuid
  createdByWaiterId String?            @map("created_by_waiter_id") @db.Uuid
  voucherId         String?            @map("voucher_id") @db.Uuid
  type              OrderType          @default(DINE_IN)
  status            OrderStatus        @default(PENDING)
  paymentStatus     OrderPaymentStatus @default(UNPAID) @map("payment_status")
  subtotal          Decimal            @default(0) @db.Decimal(14, 2)
  discountAmount    Decimal            @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount         Decimal            @default(0) @map("tax_amount") @db.Decimal(14, 2)
  serviceCharge     Decimal            @default(0) @map("service_charge") @db.Decimal(14, 2)
  totalAmount       Decimal            @default(0) @map("total_amount") @db.Decimal(14, 2)
  note              String?            @db.Text
  placedAt          DateTime           @default(now()) @map("placed_at") @db.Timestamptz(6)
  submittedAt       DateTime?          @map("submitted_at") @db.Timestamptz(6)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table           RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  reservation     Reservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  waiter          Employee?        @relation("OrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  tableSession    TableSession?    @relation(fields: [tableSessionId], references: [id], onDelete: Restrict)
  createdByWaiter Employee?        @relation("OrderCreatedByWaiter", fields: [createdByWaiterId], references: [id], onDelete: SetNull)
  voucher         Voucher?         @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]

  @@index([branchId, placedAt])
  @@index([tableId])
  @@index([waiterId])
  @@index([tableSessionId, placedAt])
  @@index([createdByWaiterId])
  @@index([status, paymentStatus])
  @@map("orders")
}

model OrderItem {
  id                   String          @id @default(uuid()) @db.Uuid
  orderId              String          @map("order_id") @db.Uuid
  menuItemId           String          @map("menu_item_id") @db.Uuid
  itemName             String          @map("item_name") @db.VarChar(150)
  unitPrice            Decimal         @map("unit_price") @db.Decimal(14, 2)
  quantity             Int
  discountAmount       Decimal         @default(0) @map("discount_amount") @db.Decimal(14, 2)
  totalPrice           Decimal         @map("total_price") @db.Decimal(14, 2)
  specialInstructions  String?         @map("special_instructions") @db.VarChar(500)
  selectedOptions      Json?           @map("selected_options")
  status               OrderItemStatus @default(PENDING)
  startedAt            DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime?       @map("completed_at") @db.Timestamptz(6)
  queuedAt             DateTime?       @map("queued_at") @db.Timestamptz(6)
  readyAt              DateTime?       @map("ready_at") @db.Timestamptz(6)
  servedAt             DateTime?       @map("served_at") @db.Timestamptz(6)
  servedByWaiterId     String?         @map("served_by_waiter_id") @db.Uuid
  unavailableAt        DateTime?       @map("unavailable_at") @db.Timestamptz(6)
  unavailableById      String?         @map("unavailable_by_id") @db.Uuid
  startedByKitchenId   String?         @map("started_by_kitchen_id") @db.Uuid
  completedByKitchenId String?         @map("completed_by_kitchen_id") @db.Uuid
  cancelledAt          DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  cancelledById        String?         @map("cancelled_by_id") @db.Uuid
  cancellationReason   String?         @map("cancellation_reason") @db.VarChar(500)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  order              Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem           MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  servedByWaiter     Employee?    @relation("OrderItemServedBy", fields: [servedByWaiterId], references: [id], onDelete: SetNull)
  unavailableBy      Employee?    @relation("OrderItemUnavailableBy", fields: [unavailableById], references: [id], onDelete: SetNull)
  startedByKitchen   Employee?    @relation("OrderItemStartedByKitchen", fields: [startedByKitchenId], references: [id], onDelete: SetNull)
  completedByKitchen Employee?    @relation("OrderItemCompletedByKitchen", fields: [completedByKitchenId], references: [id], onDelete: SetNull)
  cancelledBy        Employee?    @relation("OrderItemCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  servingTask        ServingTask?

  @@index([orderId, status])
  @@index([menuItemId])
  @@index([status, queuedAt])
  @@index([servedByWaiterId])
  @@index([startedByKitchenId])
  @@index([completedByKitchenId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  paymentCode    String        @unique @map("payment_code") @db.VarChar(50)
  orderId        String?       @map("order_id") @db.Uuid
  tableSessionId String?       @map("table_session_id") @db.Uuid
  processedById  String?       @map("processed_by_id") @db.Uuid
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(14, 2)
  transactionRef String?       @map("transaction_ref") @db.VarChar(255)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  failureReason  String?       @map("failure_reason") @db.VarChar(500)
  note           String?       @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tableSession TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: Restrict)
  processedBy  Employee?     @relation("PaymentProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([tableSessionId, status])
  @@index([processedById])
  @@index([transactionRef])
  @@map("payments")
}

model Voucher {
  id                String      @id @default(uuid()) @db.Uuid
  branchId          String?     @map("branch_id") @db.Uuid
  code              String      @unique @db.VarChar(50)
  name              String      @db.VarChar(150)
  description       String?     @db.VarChar(500)
  type              VoucherType
  value             Decimal     @db.Decimal(14, 2)
  minOrderAmount    Decimal     @default(0) @map("min_order_amount") @db.Decimal(14, 2)
  maxDiscountAmount Decimal?    @map("max_discount_amount") @db.Decimal(14, 2)
  startsAt          DateTime    @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime    @map("ends_at") @db.Timestamptz(6)
  usageLimit        Int?        @map("usage_limit")
  usageCount        Int         @default(0) @map("usage_count")
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(6)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orders Order[]

  @@index([branchId, isActive])
  @@index([startsAt, endsAt])
  @@map("vouchers")
}

model Attendance {
  id           String           @id @default(uuid()) @db.Uuid
  employeeId   String           @map("employee_id") @db.Uuid
  branchId     String           @map("branch_id") @db.Uuid
  workDate     DateTime         @map("work_date") @db.Date
  checkInAt    DateTime?        @map("check_in_at") @db.Timestamptz(6)
  checkOutAt   DateTime?        @map("check_out_at") @db.Timestamptz(6)
  status       AttendanceStatus @default(PRESENT)
  minutesLate  Int              @default(0) @map("minutes_late")
  totalMinutes Int?             @map("total_minutes")
  note         String?          @db.VarChar(500)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([employeeId, workDate])
  @@index([branchId, workDate])
  @@index([status])
  @@map("attendances")
}

model WorkSession {
  id             String            @id @default(uuid()) @db.Uuid
  employeeId     String            @map("employee_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  status         WorkSessionStatus @default(SCHEDULED)
  scheduledStart DateTime?         @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd   DateTime?         @map("scheduled_end") @db.Timestamptz(6)
  checkedInAt    DateTime?         @map("checked_in_at") @db.Timestamptz(6)
  checkedOutAt   DateTime?         @map("checked_out_at") @db.Timestamptz(6)
  isUnscheduled  Boolean           @default(false) @map("is_unscheduled")
  autoClosed     Boolean           @default(false) @map("auto_closed")
  note           String?           @db.VarChar(500)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([employeeId, status])
  @@index([branchId, status, checkedInAt])
  @@map("work_sessions")
}

model ServingTask {
  id                String            @id @default(uuid()) @db.Uuid
  orderItemId       String            @unique @map("order_item_id") @db.Uuid
  branchId          String            @map("branch_id") @db.Uuid
  status            ServingTaskStatus @default(WAITING)
  claimedByWaiterId String?           @map("claimed_by_waiter_id") @db.Uuid
  servedByWaiterId  String?           @map("served_by_waiter_id") @db.Uuid
  availableAt       DateTime          @default(now()) @map("available_at") @db.Timestamptz(6)
  claimedAt         DateTime?         @map("claimed_at") @db.Timestamptz(6)
  servedAt          DateTime?         @map("served_at") @db.Timestamptz(6)
  cancelledAt       DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  claimedByWaiter Employee? @relation("ServingTaskClaimedBy", fields: [claimedByWaiterId], references: [id], onDelete: SetNull)
  servedByWaiter  Employee? @relation("ServingTaskServedBy", fields: [servedByWaiterId], references: [id], onDelete: SetNull)

  @@index([branchId, status, availableAt])
  @@index([claimedByWaiterId, status])
  @@map("serving_tasks")
}
